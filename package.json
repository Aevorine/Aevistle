    "check:ipc-contract": "node scripts/check-ipc-contract.mjs",
    "check:visual-styles": "node scripts/check-visual-styles.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:reader-meta": "node scripts/check-reader-meta.mjs",
    "check:silent-failure": "node scripts/check-silent-failure.mjs",
