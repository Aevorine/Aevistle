    "email-scheduler",
    "scheduled-email",
    "send-email-later",
    "recurring-email",
    "email-reminder",
    "email-automation",
    "reminder-app",
    "cron",
    "smtp",
    "smtp-client",
    "imap",
    "imap-client",
    "verification-code",
    "mail-merge",
    "public-holidays",
    "icalendar",
    "android",
    "windows",
    "no-server",
    "no-telemetry",
    "privacy-friendly",
    "offline-first"
  ],
  "author": "Fusheng201",
  "license": "MIT",
  "homepage": "https://github.com/Aevorine/Aevistle",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aevorine/Aevistle.git"
  },
