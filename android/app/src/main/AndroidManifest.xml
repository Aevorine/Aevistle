<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        `usesCleartextTraffic` stays alongside `networkSecurityConfig` even
        though the config wins wherever both are read: the two agree that the
        default is deny, and the attribute is what store and audit scanners
        actually look at.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Fires a scheduled send. Not exported: only the alarm we set
            ourselves may trigger it. Exporting it would let any app on the
            device broadcast an intent and make Aevistle send mail on demand.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.aevistle.app.FIRE_JOB" />
            </intent-filter>
        </receiver>

        <!--
            Alarms do not survive a reboot or an app update; this re-arms them.

            It also re-arms the moment "Alarms & reminders" is granted. Until
            then every alarm was set inexact and Doze could batch it; without
            this, granting the permission would visibly change nothing until the
            app was next opened. Android delivers that broadcast to
            manifest-declared receivers for exactly this purpose.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Permissions, and why each one is here. The list is deliberately short —
        an app that holds your mail password has no business asking for
        contacts, location or shared storage.
    -->

    <!-- Talk to the SMTP server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Tell you whether a scheduled send succeeded, and hand you a verification
        code without making you switch apps.

        Runtime-granted from Android 13 (API 33) onward, which means declaring
        it here does nothing on its own — it is asked for at the point a
        reminder is armed or an inbox is switched on. See Permissions.java.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm schedules after the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Fire at the minute you asked for, rather than whenever the system feels
        like batching work.

        Not USE_EXACT_ALARM, which is pre-granted but reserved for alarm clocks
        and calendars — this is neither, and claiming it would be a Play policy
        violation. So: revocable, granted on install on Android 12/13 and denied
        by default from Android 14. The app degrades to an inexact alarm rather
        than failing, says so, and offers the settings screen that fixes it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Finish an in-flight send if the screen goes off mid-upload. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Scan a pairing QR code (`PairingScanner.tsx`) — the camera preview and
        frame decoding happen entirely in the WebView via `getUserMedia`, the
        same plain Web API a browser page would use. Nothing here goes through
        a plugin: declaring the permission is this manifest's whole part in
        it, and Capacitor's own WebView bridge raises the runtime dialog when
        the page first asks (see `core/bridge-android.ts`'s note). Scanning
        also has a paste fallback, so this permission is never load-bearing
        for pairing to work at all — only for the camera shortcut to it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
