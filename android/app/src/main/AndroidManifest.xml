<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        `usesCleartextTraffic` stays alongside `networkSecurityConfig` even
        though the config wins wherever both are read: the two agree that the
        default is deny, and the attribute is what store and audit scanners
        actually look at.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The OAuth2 consent redirect.

                A private-use URI scheme, which is what RFC 8252 §7.1 prescribes
                for a native app that cannot hold a loopback socket while the
                user is away in a browser. The scheme is the application id
                rather than something short and memorable like `aevistle://`,
                deliberately: a generic scheme is one another app could
                plausibly claim, and Android hands a contested scheme to
                whichever app the user picks from a chooser. Reverse-DNS on a
                domain this project controls is the collision-resistant form the
                RFC asks for. It must stay byte-identical to
                `ANDROID_REDIRECT_URI` in `src/core/oauth.ts` and to what is
                registered with Google and Microsoft — a mismatch is refused at
                the consent page, before anything reaches this filter.

                `CATEGORY_BROWSABLE` is what lets a browser start it at all, and
                is the reason this is a second filter rather than three more
                lines in the one above: adding BROWSABLE to the LAUNCHER filter
                would make the app's icon entry web-startable too.

                Claiming a scheme does not weaken the guarantees in the block
                above. The activity was already `exported="true"` — it is the
                launcher — and `launchMode="singleTask"` means a redirect
                arrives as `onNewIntent` on the running instance rather than
                starting a second copy. What arrives is a URL carrying an
                authorization code, and a code is worth nothing without the PKCE
                verifier, which never leaves the process that made it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.aevistle.app" android:host="oauth" />
            </intent-filter>

            <!--
                "Share to Aevistle" — the system share sheet.

                `text/plain` and `*/*` are both listed rather than just the
                wildcard: a filter that only claims `*/*` is matched by the
                sheet, but Android ranks and labels a share target by the most
                specific type it declares, and a share of plain text into an
                app whose only claim is "anything" is the entry that gets
                sorted to the bottom. Sharing text is the common case here —
                a link, a paragraph, a code someone sent you.

                `ACTION_SEND_MULTIPLE` is a separate action, not a flag, so
                selecting three photos and hitting Share reaches nothing
                without this. It arrives as a `ClipData`; see
                `MainActivity.recordPendingShare`.

                No new permission goes with this. The sender attaches
                `FLAG_GRANT_READ_URI_PERMISSION` to the intent, which is a
                grant on those specific URIs for as long as this task lives —
                which is why the plugin copies the bytes out immediately
                rather than storing the URI. Asking for READ_EXTERNAL_STORAGE
                to read a file someone deliberately handed us would be asking
                for the whole gallery to read one photo.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
                `mailto:` — an address tapped in a browser, a PDF, or another
                app's contact card.

                Both actions, because the two are used interchangeably in the
                wild for the same link: a web page's `<a href="mailto:…">` is
                delivered as `ACTION_VIEW`, while an app that means "send mail
                to this person" builds `ACTION_SENDTO`. Claiming only one
                leaves the other going to whatever else is installed.

                `BROWSABLE` is what lets a browser start it at all — the same
                reasoning as the OAuth filter above, and the same reason this
                is not folded into the LAUNCHER filter.

                Nothing is sent on arrival. The address lands in the compose
                screen with the cursor in it; the user still writes the mail
                and still presses send.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>

        </activity>

        <!--
            Fires a scheduled send. Not exported: only the alarm we set
            ourselves may trigger it. Exporting it would let any app on the
            device broadcast an intent and make Aevistle send mail on demand.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.aevistle.app.FIRE_JOB" />
            </intent-filter>
        </receiver>

        <!--
            Alarms do not survive a reboot or an app update; this re-arms them.

            It also re-arms the moment "Alarms & reminders" is granted. Until
            then every alarm was set inexact and Doze could batch it; without
            this, granting the permission would visibly change nothing until the
            app was next opened. Android delivers that broadcast to
            manifest-declared receivers for exactly this purpose.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The "Copy" button on a verification-code notification.

            Not exported, for the same reason `AlarmReceiver` is not: an
            exported receiver would let any app on the device broadcast an
            intent and drive this app's clipboard with a string of its
            choosing. Only the PendingIntent this app builds for its own
            notification can reach it.
        -->
        <receiver
            android:name=".CopyCodeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.aevistle.app.COPY_CODE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Permissions, and why each one is here. The list is deliberately short —
        an app that holds your mail password has no business asking for
        contacts, location or shared storage.
    -->

    <!-- Talk to the SMTP server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Tell you whether a scheduled send succeeded, and hand you a verification
        code without making you switch apps.

        Runtime-granted from Android 13 (API 33) onward, which means declaring
        it here does nothing on its own — it is asked for at the point a
        reminder is armed or an inbox is switched on. See Permissions.java.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm schedules after the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Fire at the minute you asked for, rather than whenever the system feels
        like batching work.

        Not USE_EXACT_ALARM, which is pre-granted but reserved for alarm clocks
        and calendars — this is neither, and claiming it would be a Play policy
        violation. So: revocable, granted on install on Android 12/13 and denied
        by default from Android 14. The app degrades to an inexact alarm rather
        than failing, says so, and offers the settings screen that fixes it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Finish an in-flight send if the screen goes off mid-upload. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Hand a downloaded update to the system package installer.

        This app is distributed as an APK from its own GitHub releases, not
        through a store, so there is no store client to do updates for it. The
        alternative is telling the user to open a browser, find the release
        page, download an APK into a shared folder and tap it — which is the
        same install with the verification removed and the file left somewhere
        any other app can read.

        What this permission does *not* grant is silent installation. From
        Android 8 it is additionally a per-app toggle in system settings, and
        even holding both the user still confirms every install on the
        system's own screen. See `UpdateInstaller.canInstall`.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Scan a pairing QR code (`PairingScanner.tsx`) — the camera preview and
        frame decoding happen entirely in the WebView via `getUserMedia`, the
        same plain Web API a browser page would use. Nothing here goes through
        a plugin: declaring the permission is this manifest's whole part in
        it, and Capacitor's own WebView bridge raises the runtime dialog when
        the page first asks (see `core/bridge-android.ts`'s note). Scanning
        also has a paste fallback, so this permission is never load-bearing
        for pairing to work at all — only for the camera shortcut to it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
